{
  "name": "otonom-worker",
  "version": "0.1.0",
  "private": true,
  "description": "High-throughput OpenCode GitHub Actions swarm harness for OTONOM",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:skills": "node --loader ts-node/esm scripts/validate-skills.ts",
    "generate-matrix": "tsx harness/matrix/generator.ts",
    "finalize": "tsx harness/finalizer/cli.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.32",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "picomatch": "^4.0.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/picomatch": "^3.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
